# FitForge Environment Variables Configuration
# Copy this file to .env.local for local development, or add these to Vercel Project Environment Settings.

# Supabase Project API URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (safe for client-side queries protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Service Role Key (for administrative scripts/migrations only - NEVER expose in client code)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
